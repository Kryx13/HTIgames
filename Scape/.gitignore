# --- Unity Standard ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures & Recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- IDEs (Fichiers générés automatiquement) ---
# Visual Studio / VS Code
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.sln.iml

# --- OS Generated (Mac / Windows junk) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Builds & Exports ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
/ExportedObj/
.consulo/

# --- Meta Files ---
# Never ignore asset meta files
!/[Aa]ssets/**/*.meta

# --- Plugins specifics ---
# Ignore Crashlytics/Firebase generated resources
/Assets/StreamingAssets/google-services-desktop.json
/Assets/Plugins/Android/assets/installed_assets.json